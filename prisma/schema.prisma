generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "typedSql"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, unaccent, pgcrypto]
}

model categories {
  category_id   Int          @id @default(autoincrement())
  category_name String          @unique @db.VarChar(255)
  products      products[]
  subcategories subcategories[]
}

model newsletter_emails {
  id         Int       @id @default(autoincrement())
  email      String    @unique @db.VarChar(255)
  created_at DateTime? @default(now()) @db.Timestamp(6)
}

model products {
  product_id           Int                    @id(map: "raws_products_pkey") @default(autoincrement())
  product_name         String                 @unique(map: "unique_product_name") @db.VarChar(255)
  provider_id          Int?
  purchase_price       Int
  sell_price           Int?
  resellers_price      Int?
  in_stock             Boolean                @default(true)
  category_id          Int?
  product_description  String?
  created_at           DateTime               @default(now()) @db.Timestamp(6)
  product_slug         String?                @db.VarChar(255)
  discount_percent     Int?                   @default(0)
  subcategory_id       Int?
  stock                Int?                   @default(0) @db.SmallInt
  images               String[]
  deleted_at           DateTime?              @db.Date
  categories           categories?            @relation(fields: [category_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_products_category")
  providers            providers?             @relation(fields: [provider_id], references: [provider_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_products_provider")
  subcategories        subcategories?         @relation(fields: [subcategory_id], references: [subcategory_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_products_subcategory")
  purchase_order_items purchase_order_items[]
}

model products_images {
  img_id     Int     @id(map: "raws_images_pkey") @default(autoincrement())
  product_id Int
  img_url    String  @db.VarChar(255)
  img_alt    String? @db.VarChar(255)
}

model providers {
  provider_id   Int        @id @default(autoincrement())
  provider_name String     @unique(map: "unique_provider_name") @db.VarChar(255)
  products      products[]
}

model purchase_order_items {
  order_item_id   Int             @id @default(autoincrement())
  order_id        Int
  product_id      Int
  quantity        Int
  unit_price      Int
  unit_cost       Int?            @default(0)
  subtotal        Int?            @default(dbgenerated("(quantity * unit_price)"))
  discount        Int?            @default(0)
  total           Int?            @default(dbgenerated("((quantity * unit_price) - discount)"))
  date_added      DateTime?       @default(now()) @db.Timestamp(6)
  purchase_orders purchase_orders @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: NoAction)
  products        products        @relation(fields: [product_id], references: [product_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([order_id], map: "idx_purchase_order_items_order_id")
}

model purchase_orders {
  order_id             Int                    @id @default(autoincrement())
  client_id            Int?
  user_id              Int?
  order_date           DateTime               @default(now()) @db.Timestamp(6)
  order_status         order_status_type
  payment_method       payment_method_type
  payment_status       payment_status_type
  client               String?
  purchase_order_items purchase_order_items[]
}

model subcategories {
  subcategory_id   Int         @id @default(autoincrement())
  subcategory_name String      @db.VarChar(255)
  category_id      Int?
  products         products[]
  categories       categories? @relation(fields: [category_id], references: [category_id], onUpdate: NoAction)
}

model User {
  id               String   @id @default(dbgenerated("(gen_random_uuid())::text")) @db.VarChar(255)
  name             String   @db.VarChar(255)
  email            String   @unique(map: "user_email_unique") @db.VarChar(255)
  emailVerified    Boolean  @default(false) @map("email_verified")
  phoneNumber      String?  @unique(map: "phone_number_unique") @db.VarChar(50) @map("phone_number")
  phoneNumberValid Boolean? @map("phone_number_verified")
  image            String?  @db.VarChar(255)
  role             user_role?
  createdAt        DateTime @default(now()) @db.Timestamp(6) @map("created_at")
  updatedAt        DateTime @default(now()) @db.Timestamp(6) @map("updated_at")
  account          Account[]
  session          Session[]

  @@map("user")
}

model Session {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text")) @db.VarChar(255)
  expiresAt DateTime @db.Timestamp(6) @map("expires_at")
  token     String   @unique(map: "session_token_unique") @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamp(6) @map("created_at")
  updatedAt DateTime @default(now()) @db.Timestamp(6) @map("updated_at")
  ipAddress String?  @db.VarChar(255) @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @db.VarChar(255) @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "session_user_fkey")

  @@index([userId], map: "session_userid_idx")
  @@map("session")
}

model Account {
  id                    String    @id @default(dbgenerated("(gen_random_uuid())::text")) @db.VarChar(255)
  accountId             String    @db.VarChar(255) @map("account_id")
  providerId            String    @db.VarChar(255) @map("provider_id")
  userId                String    @db.VarChar(255) @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("idtoken")
  accessTokenExpiresAt  DateTime? @db.Timestamp(6) @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @db.Timestamp(6) @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamp(6) @map("created_at")
  updatedAt             DateTime  @default(now()) @db.Timestamp(6) @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "account_user_fkey")

  @@index([userId], map: "account_userid_idx")
  @@map("account")
}

model Verification {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text")) @db.VarChar(255)
  identifier String   @db.VarChar(255)
  value      String   @db.VarChar(255)
  expiresAt  DateTime @db.Timestamp(6)
  createdAt  DateTime @default(now()) @db.Timestamp(6)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamp(6)

  @@index([identifier])
  @@map("verification")
}

enum order_status_type {
  Sin_confirmar       @map("Sin confirmar")
  Pendiente_de_compra @map("Pendiente de compra")
  Lista_para_enviar   @map("Lista para enviar")
  Vendida
}

enum payment_method_type {
  No_especificado    @map("No especificado")
  Efectivo
  Transferencia
  Tarjeta_de_debito  @map("Tarjeta de débito")
  Tarjeta_de_credito @map("Tarjeta de crédito")
}

enum payment_status_type {
  Pendiente
  Pago_parcial  @map("Pago parcial")
  Pago_completo @map("Pago completo")
}

enum user_role {
  ADMIN
  USER
}
