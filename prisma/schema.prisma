generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "typedSql"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, pgcrypto, unaccent]
}

model categories {
  category_id   Int          @id @default(autoincrement())
  category_name String          @unique @db.VarChar(255)
  category_slug String          @unique @db.VarChar(255)

  products      products[]
  subcategories subcategories[]

  @@index([category_slug])
}

model newsletter_emails {
  id         Int       @id @default(autoincrement())
  email      String    @unique @db.VarChar(255)
  created_at DateTime? @default(now()) @db.Timestamp(6)
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model products {
  product_id          Int                 @id @default(autoincrement())
  product_name        String?             @unique(map: "unique_products_name") @db.VarChar(255)
  purchase_price      Int?
  sell_price          Int?
  resellers_price     Int?
  discount_percent    Int                 @default(0) @db.SmallInt
  category_id         Int?                @db.SmallInt
  subcategory_id      Int?                @db.SmallInt
  in_stock            Boolean             @default(true)
  stock               Int                 @default(0) @db.SmallInt
  provider_ids        Int[]               @db.SmallInt
  product_description String?
  images              String[]
  product_slug        String?
  created_at          DateTime?           @default(now()) @db.Timestamp(6)
  updated_at          DateTime?           @db.Timestamp(6)
  deleted_at          DateTime?           @db.Timestamp(6)

  categories           categories?            @relation(fields: [category_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_products_category")
  subcategories        subcategories?         @relation(fields: [subcategory_id], references: [subcategory_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_products_subcategory")
  purchase_order_items purchase_order_items[]
  product_questions   product_questions[]
  product_reviews     product_reviews[]
}

model providers {
  provider_id   Int    @id @default(autoincrement())
  provider_name String @unique(map: "unique_provider_name") @db.VarChar(255)
}

model purchase_order_items {
  order_item_id             Int              @id @default(autoincrement())
  order_id                  Int
  product_id                Int
  quantity                  Int
  date_added                DateTime?        @default(now()) @db.Timestamp(6)
  product_name_snapshot     String           @db.VarChar(255)
  product_slug_snapshot     String?          @db.VarChar(255)
  product_image_snapshot    String?
  product_cost_snapshot     Int?
  product_price_snapshot    Int
  product_discount_snapshot Int?             @default(0)
  total                     Int?             @default(dbgenerated("((quantity * product_price_snapshot) - product_discount_snapshot)"))

  purchase_orders           purchase_orders  @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: NoAction)
  products        products         @relation(fields: [product_id], references: [product_id], onDelete: Cascade, onUpdate: NoAction)
  product_review            product_reviews?

  @@index([order_id], map: "idx_purchase_order_items_order_id")
  @@index([product_id], map: "idx_purchase_order_items_product_id")
}

model purchase_orders {
  order_id             Int                    @id @default(autoincrement())
  client_id            Int?
  user_id              String?                @db.VarChar(255)
  order_date           DateTime               @default(now()) @db.Timestamp(6)
  order_status         order_status_type      @default(unconfirmed)
  payment_method       payment_method_type    @default(unspecified)
  payment_status       payment_status_type    @default(pending)
  customer_name        String?                @db.VarChar(255)
  customer_email       String?                @db.VarChar(255)
  customer_phone       String?                @db.VarChar(50)
  origin               purchase_order_origin  @default(MANUAL_ADMIN)
  delivered_at         DateTime?              @db.Timestamp(6)

  purchase_order_items purchase_order_items[]
  user                 User?                  @relation(fields: [user_id], references: [id])

  @@index([user_id], map: "idx_purchase_orders_user_id")
  @@index([order_status, delivered_at], map: "idx_purchase_orders_status_delivered_at")
}

model subcategories {
  subcategory_id   Int         @id @default(autoincrement())
  subcategory_name String      @db.VarChar(255)
  category_id      Int?
  subcategory_slug String      @db.VarChar(255)

  products         products[]
  categories       categories? @relation(fields: [category_id], references: [category_id], onUpdate: NoAction)

  @@unique([category_id, subcategory_slug])
  @@index([subcategory_slug])
}

model User {
  id                 String              @id @default(dbgenerated("(gen_random_uuid())::text")) @db.VarChar(255)
  name               String              @db.VarChar(255)
  email              String              @unique(map: "user_email_unique") @db.VarChar(255)
  emailVerified      Boolean             @default(false) @map("email_verified")
  phoneNumber        String?             @unique(map: "phone_number_unique") @map("phone_number") @db.VarChar(50)
  phoneNumberValid   Boolean?            @map("phone_number_verified")
  image              String?             @db.VarChar(255)
  role               String?             @default("user") @db.VarChar(50)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt          DateTime            @default(now()) @map("updated_at") @db.Timestamp(6)

  account            Account[]
  session            Session[]
  purchase_orders    purchase_orders[]
  product_reviews    product_reviews[]
  answered_questions product_questions[] @relation("AnsweredProductQuestions")

  @@map("user")
}

model product_reviews {
  review_id            Int                   @id @default(autoincrement())
  user_id              String                @db.VarChar(255)
  product_id           Int
  order_item_id        Int                   @unique(map: "unique_product_review_order_item")
  rating               Int                   @db.SmallInt
  comment              String?
  status               product_review_status @default(PENDING)
  created_at           DateTime              @default(now()) @db.Timestamp(6)
  updated_at           DateTime?             @updatedAt @db.Timestamp(6)
  moderated_at         DateTime?             @db.Timestamp(6)

  products             products              @relation(fields: [product_id], references: [product_id], onDelete: Cascade, onUpdate: NoAction)
  user                 User                  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  purchase_order_items purchase_order_items  @relation(fields: [order_item_id], references: [order_item_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, product_id], map: "unique_product_review_user_product")
  @@index([product_id, status], map: "idx_product_reviews_product_status")
  @@index([status, created_at], map: "idx_product_reviews_status_created_at")
}

model product_questions {
  question_id    Int                     @id @default(autoincrement())
  product_id     Int
  author_name    String?                 @db.VarChar(120)
  author_email   String?                 @db.VarChar(255)
  question       String
  answer         String?
  status         product_question_status @default(PENDING)
  answered_by    String?                 @db.VarChar(255)
  created_at     DateTime                @default(now()) @db.Timestamp(6)
  answered_at    DateTime?               @db.Timestamp(6)
  answeredByUser User?                   @relation("AnsweredProductQuestions", fields: [answered_by], references: [id], onUpdate: NoAction)
  products       products                @relation(fields: [product_id], references: [product_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([product_id, status], map: "idx_product_questions_product_status")
  @@index([status, created_at], map: "idx_product_questions_status_created_at")
}

model Session {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text")) @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamp(6)
  token     String   @unique(map: "session_token_unique") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamp(6)
  ipAddress String?  @map("ip_address") @db.VarChar(255)
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.VarChar(255)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "session_user_fkey")

  @@index([userId], map: "session_userid_idx")
  @@map("session")
}

model Account {
  id                    String    @id @default(dbgenerated("(gen_random_uuid())::text")) @db.VarChar(255)
  accountId             String    @map("account_id") @db.VarChar(255)
  providerId            String    @map("provider_id") @db.VarChar(255)
  userId                String    @map("user_id") @db.VarChar(255)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("idtoken")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamp(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamp(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamp(6)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "account_user_fkey")

  @@index([userId], map: "account_userid_idx")
  @@map("account")
}

model Verification {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text")) @db.VarChar(255)
  identifier String   @db.VarChar(255)
  value      String   @db.VarChar(255)
  expiresAt  DateTime @db.Timestamp(6)
  createdAt  DateTime @default(now()) @db.Timestamp(6)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamp(6)

  @@index([identifier])
  @@map("verification")
}

enum order_status_type {
  unconfirmed
  pending_purchase
  ready_to_ship
  delivered
  cancelled
}

enum payment_method_type {
  unspecified
  cash
  bank_transfer
  debit_card
  credit_card
  mercado_pago
}

enum payment_status_type {
  pending
  partial_payment
  full_payment
}

enum purchase_order_origin {
  MANUAL_ADMIN @map("manual_admin")
  WEB_WHATSAPP @map("web_whatsapp")
}

enum product_review_status {
  PENDING  @map("pending")
  APPROVED @map("approved")
  REJECTED @map("rejected")
}

enum product_question_status {
  PENDING  @map("pending")
  ANSWERED @map("answered")
  HIDDEN   @map("hidden")
}
